# Yatra — India Travel Agent
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# IBM Cloud API key (create at: https://cloud.ibm.com/iam/apikeys)
IBM_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai text generation endpoint (region-specific)
IBM_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29

# IBM Granite model ID
IBM_MODEL_ID=ibm/granite-4-h-small

# Your IBM watsonx.ai project ID (found in watsonx project settings)
IBM_PROJECT_ID=your_project_id_here

# Server port (optional — defaults to 8080)
# PORT=8080
